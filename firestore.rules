rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Oasis RV Park — only the owner account may read or write park data.
    // Replace YOUR_UID_HERE with the account ID shown in the app after you
    // sign in the first time (the orange banner). Keep the quotes.

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId
                         && request.auth.uid == "YOUR_UID_HERE";
    }
  }
}
